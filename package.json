{
  "name": "pmg-layer",
  "version": "0.1.0",
  "description": "A reusable Nuxt 4 layer with shared components, composables, utils and config.",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config": "./nuxt.config.ts"
  },
  "types": "./index.d.ts",
  "files": [
    "app",
    "stores",
    "server",
    "public",
    "nuxt.config.ts",
    "i18n.config.ts",
    "index.d.ts"
  ],
  "scripts": {
    "dev": "nuxi dev .playground",
    "dev:build": "nuxi build .playground",
    "dev:prepare": "nuxi prepare .playground",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@nuxt/icon": "^2.3.1",
    "@nuxtjs/i18n": "^9.1.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/nuxt": "^14.0.0",
    "models": "github:pmg-github/models",
    "reka-ui": "^2.6.0",
    "sortablejs": "^1.15.6",
    "swiper": "^12.0.3",
    "tailwindcss": "^3.4.19",
    "vee-validate": "^4.15.1",
    "vue-draggable-next": "^2.3.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.27.4",
    "@tiptap/vue-3": "^3.27.4",
    "nuxt": "^4.0.0",
    "vue-tsc": "^3.3.7",
    "yup": "^1.7.1"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.26.0 <4",
    "@tiptap/vue-3": ">=3.26.0 <4",
    "nuxt": "^4.0.0"
  }
}
