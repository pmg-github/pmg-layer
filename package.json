{
  "name": "pmg-layer",
  "version": "0.1.0",
  "description": "A reusable Nuxt 4 layer with shared components, composables, utils and config.",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./nuxt.config": "./nuxt.config.ts",
    "./utils/extensions/video": {
      "types": "./app/utils/extensions/video.ts",
      "import": "./app/utils/extensions/video.ts"
    },
    "./utils/extensions/gallery": {
      "types": "./app/utils/extensions/gallery.ts",
      "import": "./app/utils/extensions/gallery.ts"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "app",
    "stores",
    "server",
    "public",
    "nuxt.config.ts",
    "i18n.config.ts",
    "index.d.ts"
  ],
  "scripts": {
    "dev": "nuxi dev .playground",
    "dev:build": "nuxi build .playground",
    "dev:prepare": "nuxi prepare .playground",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^9.1.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "@tiptap/core": "^3.27.4",
    "@tiptap/vue-3": "^3.27.4",
    "@vueuse/nuxt": "^14.0.0",
    "models": "github:pmg-github/models",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "nuxt": "^4.0.0",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
